# Copy to .env and fill in. Every value is optional: without them the app
# falls back to deployments/31337.json written by the deploy script.

# Overrides for the contract addresses. Use when pointing at Sepolia or when
# you want to force specific addresses regardless of the deployment file.
# Note: TokenA/TokenB are deploy labels, the pair sorts them into token0/token1
# internally and the UI reads that canonical order from the pair.
VITE_TOKEN_A_ADDRESS=
VITE_TOKEN_B_ADDRESS=
VITE_DEX_PAIR_ADDRESS=

# Only needed to connect mobile wallets over WalletConnect on Sepolia.
# Get one at cloud.walletconnect.com. Local (anvil) use works without it.
VITE_WALLETCONNECT_PROJECT_ID=
